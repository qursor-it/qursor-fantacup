# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://fantadc:fantadc@localhost:5432/fantadc"

# ─── Auth.js v5 ────────────────────────────────────────────────────────────────
# Generare con: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Durata sessione in secondi (default: 30 giorni = 2592000)
AUTH_SESSION_MAX_AGE=2592000

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Email e password dell'admin sincronizzato con `npm run db:seed-admin`.
# In deploy queste variabili arrivano dalle credential Jenkins
# (fantadc-admin-dev / fantadc-admin-prod); in locale impostale qui.
ADMIN_EMAIL="admin@fantadc.local"
ADMIN_PASSWORD="<scegli-una-password-forte>"

# ─── Ambiente (opzionale) ───────────────────────────────────────────────────────
# NODE_ENV="production"

# URL pubblica dell'applicazione.
# Serve per metadata assoluti, manifest PWA, deep link nelle notifiche e packaging store.
NEXTAUTH_URL="https://fantadc.example.com"
# In alternativa puoi esporre la stessa URL anche lato client se necessario.
# NEXT_PUBLIC_APP_URL="https://fantadc.example.com"

# ─── Servizio stories (Quarkus, cartella quarkus/) ─────────────────────────────
# Chiave privata RSA (PEM) con cui Next firma i token per il servizio stories.
# In locale va bene la chiave di sviluppo: quarkus/dev-keys/privateKey.pem
# (a capo scritti come \n). In produzione usare una coppia nuova, mai quella di dev-keys.
# Se manca, GET /api/stories/token risponde 503.
# STORIES_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
